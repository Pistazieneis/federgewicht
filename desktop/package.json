{
  "name": "federgewicht",
  "version": "0.1.0",
  "main": "main.js",
  "description": "Federgewicht - Idle-Game: Meteoriten abbauen, bevor sie einschlagen",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11"
  },
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . Federgewicht --platform=win32 --arch=x64 --out=../dist --overwrite --prune=true",
    "package:mac": "electron-packager . Federgewicht --platform=darwin --arch=x64,arm64 --out=../dist --overwrite --prune=true",
    "test": "node ../tools/sim.js 10"
  },
  "private": true
}
